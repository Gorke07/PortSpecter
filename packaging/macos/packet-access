#!/bin/sh
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
state=/var/db/portspecter-packet-access
label=org.portspecter.packet-access
[ "$(id -u)" = 0 ] || { echo 'Administrator authorization is required.' >&2; exit 1; }
case "${1:-}" in
    apply)
        dscl . -read /Groups/access_bpf >/dev/null
        # Use the shared capture group rather than making BPF world-writable.
        # The daemon also handles nodes created after login or reboot.
        for device in /dev/bpf*; do
            [ -c "$device" ] && [ ! -L "$device" ] || continue
            chgrp access_bpf "$device"
            chmod g+rw "$device"
        done
        ;;
    remove)
        launchctl bootout "system/$label" 2>/dev/null || true
        if [ -f "$state/added-users" ]; then
            while IFS= read -r account; do
                case "$account" in ''|*[!a-zA-Z0-9._-]*) continue ;; esac
                dseditgroup -o edit -d "$account" -t user access_bpf || true
            done < "$state/added-users"
            rm -f "$state/added-users"
        fi
        rm -f /Library/LaunchDaemons/org.portspecter.packet-access.plist
        rm -f '/Library/Application Support/PortSpecter/PacketAccess/packet-access'
        rmdir '/Library/Application Support/PortSpecter/PacketAccess' 2>/dev/null || true
        rmdir "$state" 2>/dev/null || true
        pkgutil --forget org.portspecter.packet-access >/dev/null 2>&1 || true
        echo 'PortSpecter packet access removed. Log out and back in to refresh group membership.'
        echo 'The shared access_bpf group and permissions used by other capture applications are retained.'
        ;;
    *) echo 'Usage: packet-access apply|remove' >&2; exit 2 ;;
esac
